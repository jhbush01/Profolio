{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profolio",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],

  // `main` and `assets` are filled in by @astrojs/cloudflare at build time; it
  // reads this file and writes a deploy-ready config to dist/server/wrangler.json.
  // Prerendered pages are served straight from the edge, so the Worker only runs
  // for routes marked `export const prerender = false` (the /api/* endpoints).

  // Document metadata. `database_id` is an identifier, not a credential — it
  // grants nothing without account authentication, which is why Cloudflare's
  // own templates commit it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "profolio",
      "database_id": "6765d921-d062-41db-8474-a3327ab5c17d",
      "migrations_dir": "migrations"
    }
  ],

  // Document bytes. Created with
  // `npx wrangler r2 bucket create profolio-documents`.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "profolio-documents"
    }
  ],

  "vars": {
    // Cloudflare Access settings, used to verify the signed JWT that Access
    // attaches to every request it lets through. Both must be set or the API
    // refuses every request — see src/lib/server/access.ts.
    //
    // Neither is a secret: the team domain is public, and the AUD tag only
    // identifies which Access application a token was issued for. They are
    // checked against the signature, they do not grant anything.
    "ACCESS_TEAM_DOMAIN": "blue-band-b8e0.cloudflareaccess.com",
    "ACCESS_AUD": "9059f6b2ca6d38e7762d83d6c16beeefb2322304965bebe37907693e0d7023d2"
  }
}
