{
  "name": "profolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Digital teaching portfolio \u2014 organise and present evidence from a teaching sequence.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "deploy": "wrangler deploy -c dist/server/wrangler.json",
    "dev:worker": "astro build && wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state --var ACCESS_DEV_BYPASS:true",
    "db:migrate:local": "wrangler d1 migrations apply profolio --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply profolio --remote",
    "db:migrate:status": "wrangler d1 migrations list profolio --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.129.0"
  }
}
