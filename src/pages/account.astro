---
/**
 * Account: how your ProFolio presents itself, and how to leave.
 *
 * Reached from the account menu in the top bar. Everything here is set once
 * and forgotten, which is exactly why it should not have been sitting at the
 * top of the page you open to find one artefact.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Account"
  description="Your cover details, storage, and how to remove your data."
  width="reading"
>
  <PageHeader
    eyebrow="Account"
    title="Your account"
    lead="How your ProFolio presents itself, and what to do when you are finished with it."
  />

  <p id="account-status" role="status" aria-live="polite" class="mb-4 text-xs text-ink-muted"></p>

  <div class="flex flex-col gap-6">
    <section class="card p-6">
      <h2 class="text-base font-semibold">Signed in</h2>
      <p id="account-page-email" class="mt-1 break-all text-sm font-medium">…</p>
      <p id="account-usage" class="prose-body mt-1 text-xs">…</p>
    </section>

    <!-- Printed on the PDF cover page, and shown at the top of Your ProFolio. -->
    <section class="card p-6">
      <h2 class="text-base font-semibold">Cover details</h2>
      <p class="prose-body mb-4 mt-1 text-xs">
        These head your ProFolio and print on the front page of every export.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Your name</span>
          <input
            id="profile-name"
            type="text"
            placeholder="e.g. Jordan Rivers"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Title or role</span>
          <input
            id="profile-title"
            type="text"
            placeholder="e.g. Pre-service Teacher"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5 sm:col-span-2">
          <span class="text-xs font-medium">Short summary</span>
          <textarea
            id="profile-summary"
            rows="3"
            placeholder="One or two lines about what this portfolio contains."
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"></textarea>
        </label>
      </div>
    </section>

    <section id="your-data" class="scroll-mt-24">
      <h2 class="text-lg font-semibold">Your data</h2>
      <p class="prose-body mt-1 text-sm">
        Everything here belongs to you and is visible only to you.{' '}
        <a href="/privacy" class="text-accent underline underline-offset-2">
          What is stored, and for how long
        </a>.
      </p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
        <div class="card flex-1 p-5">
          <h3 class="text-sm font-semibold">Clear everything</h3>
          <p class="prose-body mt-1 text-xs">
            Removes every file, folder and project, and your cover details. The account stays, so
            you can start again.
          </p>
          <button
            id="clear-all"
            type="button"
            class="mt-3 rounded-md border border-line bg-surface px-3 py-1.5 text-xs font-medium text-ink-muted transition hover:border-critical/40 hover:text-critical"
          >
            Clear everything
          </button>
        </div>

        <div class="card flex-1 p-5">
          <h3 class="text-sm font-semibold">Delete your account</h3>
          <p class="prose-body mt-1 text-xs">
            All of the above, plus the account and the record of which sign-ins reach it. Signing in
            again gives you a new, empty ProFolio.
          </p>
          <button
            id="delete-account"
            type="button"
            class="mt-3 rounded-md border border-critical/40 bg-surface px-3 py-1.5 text-xs font-medium text-critical transition hover:bg-critical hover:text-white"
          >
            Delete account
          </button>
        </div>
      </div>

      <p class="prose-body mt-3 text-xs">
        Export a PDF first if you want a copy — deletion is immediate and you cannot undo it.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initAccount } from '../lib/vault/account-ui';
  initAccount();
</script>
