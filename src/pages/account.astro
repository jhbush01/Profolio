---
/**
 * Account: how your ProFolio presents itself, and how to leave.
 *
 * Reached from the account menu in the top bar. Everything here is set once
 * and forgotten, which is exactly why it should not have been sitting at the
 * top of the page you open to find one artefact.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Account"
  description="Your cover details, storage, and how to remove your data."
  width="reading"
>
  <PageHeader
    eyebrow="Account"
    title="Your account"
    lead="How your ProFolio presents itself, and what to do when you are finished with it."
  />

  <p id="account-status" role="status" aria-live="polite" class="mb-4 text-xs text-ink-muted"></p>

  <div class="flex flex-col gap-6">
    <section class="card p-6">
      <h2 class="text-base font-semibold">Signed in</h2>
      <p id="account-page-email" class="mt-1 break-all text-sm font-medium">…</p>
      <p id="account-usage" class="prose-body mt-1 text-xs">…</p>
    </section>

    <!-- Printed on the PDF cover page, and shown at the top of Home. -->
    <section class="card p-6">
      <h2 class="text-base font-semibold">Cover details</h2>
      <p class="prose-body mb-4 mt-1 text-xs">
        These head your Home page and print on the front page of every export.
      </p>

      <div class="mb-5 flex items-center gap-4 border-b border-line-subtle pb-5">
        <!-- Initials until there is a picture, so the slot is never empty. -->
        <div
          id="avatar-preview"
          class="flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-md bg-accent-soft font-display text-2xl text-accent"
        >
          &nbsp;
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium">Your picture</p>
          <p class="prose-body mt-0.5 text-xs">
            Optional. Scaled down in your browser before it is sent, so a photo
            straight off a phone is fine.
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            <button
              id="avatar-choose"
              type="button"
              class="rounded-md border border-line bg-surface px-3 py-1.5 text-xs font-medium transition hover:border-accent/40 hover:text-accent"
            >
              Choose image
            </button>
            <button
              id="avatar-remove"
              type="button"
              hidden
              class="rounded-md px-3 py-1.5 text-xs font-medium text-ink-muted transition hover:text-critical"
            >
              Remove
            </button>
          </div>
          <input id="avatar-input" type="file" accept="image/*" class="sr-only" />
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Your name</span>
          <input
            id="profile-name"
            type="text"
            placeholder="e.g. Jordan Rivers"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Title or role</span>
          <input
            id="profile-title"
            type="text"
            placeholder="e.g. Pre-service Teacher"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5 sm:col-span-2">
          <span class="text-xs font-medium">Short summary</span>
          <textarea
            id="profile-summary"
            rows="3"
            placeholder="One or two lines about what this portfolio contains."
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"></textarea>
        </label>
      </div>
    </section>

    <section class="card p-6">
      <h2 class="text-base font-semibold">Teaching philosophy</h2>
      <p class="prose-body mb-3 mt-1 text-xs">
        Your statement of practice, in your own words. It follows the cover page on export.
      </p>
      <textarea
        id="profile-philosophy"
        rows="10"
        placeholder="What you believe about teaching and learning, and how that shows up in your classroom."
        class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm leading-relaxed"></textarea>
      <p class="prose-body mt-2 text-xs">
        Nobody drafts this for you. It is the one part of a portfolio that has to be yours.
      </p>
    </section>

    <section class="card p-6">
      <h2 class="text-base font-semibold">Contact details</h2>
      <p class="prose-body mb-4 mt-1 text-xs">
        Printed on the cover page so whoever reads your portfolio can reach you. All optional.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Email</span>
          <input
            id="contact-email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Phone</span>
          <input
            id="contact-phone"
            type="tel"
            autocomplete="tel"
            placeholder="e.g. 0400 000 000"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5 sm:col-span-2">
          <span class="text-xs font-medium">Location</span>
          <input
            id="contact-location"
            type="text"
            placeholder="e.g. Brisbane, QLD"
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
          />
        </label>
        <label class="flex flex-col gap-1.5 sm:col-span-2">
          <span class="text-xs font-medium">Links</span>
          <textarea
            id="contact-links"
            rows="3"
            placeholder="One per line — a portfolio site, a professional profile."
            class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"></textarea>
        </label>
      </div>
      <p class="prose-body mt-3 text-xs">
        This is the one place in ProFolio where a real name and address belong. Everything you
        upload still follows the de-identification rules.
      </p>
    </section>

    <section id="your-data" class="scroll-mt-24">
      <h2 class="text-lg font-semibold">Your data</h2>
      <p class="prose-body mt-1 text-sm">
        Everything here belongs to you and is visible only to you.{' '}
        <a href="/privacy" class="text-accent underline underline-offset-2">
          What is stored, and for how long
        </a>.
      </p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
        <div class="card flex-1 p-5">
          <h3 class="text-sm font-semibold">Clear everything</h3>
          <p class="prose-body mt-1 text-xs">
            Removes every file, folder and project, and your cover details. The account stays, so
            you can start again.
          </p>
          <button
            id="clear-all"
            type="button"
            class="mt-3 rounded-md border border-line bg-surface px-3 py-1.5 text-xs font-medium text-ink-muted transition hover:border-critical/40 hover:text-critical"
          >
            Clear everything
          </button>
        </div>

        <div class="card flex-1 p-5">
          <h3 class="text-sm font-semibold">Delete your account</h3>
          <p class="prose-body mt-1 text-xs">
            All of the above, plus the account and the record of which sign-ins reach it. Signing in
            again gives you a new, empty ProFolio.
          </p>
          <button
            id="delete-account"
            type="button"
            class="mt-3 rounded-md border border-critical/40 bg-surface px-3 py-1.5 text-xs font-medium text-critical transition hover:bg-critical hover:text-white"
          >
            Delete account
          </button>
        </div>
      </div>

      <p class="prose-body mt-3 text-xs">
        Export a PDF first if you want a copy — deletion is immediate and you cannot undo it.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initAccount } from '../lib/vault/account-ui';
  initAccount();
</script>
