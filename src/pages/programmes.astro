---
/**
 * Programmes — selectable templates over the same vault.
 *
 * A programme holds the evidence you assign to it, within a date window, and
 * scores that against a checklist. Membership is many-to-many, so one artefact
 * counts toward a placement and a professional-development year at once
 * without being copied. Closing a programme fixes what it holds.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Projects"
  description="Track evidence against a template, such as a final placement or a year of professional development, with a date window and a checklist."
>
  <PageHeader
    eyebrow="Projects"
    title="Projects"
    lead="Pick a template and set your dates, then assign evidence as you capture it. The checklist shows what is still missing."
  />

  <p id="programme-status" role="status" aria-live="polite" class="mb-4 text-xs text-ink-muted"></p>

  <section id="programme-list" class="mb-10 flex flex-col gap-5"></section>

  <p
    id="programme-empty"
    hidden
    class="mb-10 rounded-lg border border-dashed border-line bg-surface p-6 text-center text-sm text-ink-muted"
  >
    No projects yet. Start one below. Evidence already in your vault that fits its checklist is offered for you to add.
  </p>

  <section>
    <h2 class="mb-1 text-xl font-semibold">Available templates</h2>
    <p class="prose-body mb-4 text-sm">
      You can run more than one at a time, and one record can sit in several. A certificate
      can count toward a placement and that year's professional development without being
      uploaded twice.
    </p>
    <div id="template-list" class="grid gap-4 sm:grid-cols-2"></div>
  </section>
</BaseLayout>

<script>
  import { initProgrammes } from '../lib/vault/programme-ui';
  initProgrammes();
</script>
