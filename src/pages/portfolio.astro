---
/**
 * The generic portfolio builder — industry-neutral.
 *
 * The page shell is still prerendered; the data comes from /api/* at runtime.
 * Documents live in R2, their metadata in D1, and access is gated by
 * Cloudflare Access — see src/lib/server/access.ts.
 *
 * PDF assembly still happens in the browser: bytes are streamed down from R2
 * one document at a time and never round-trip back up.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Portfolio builder"
  description="Build a simple digital portfolio: upload documents, organise them into folders, and export a tidy PDF."
>
  <PageHeader
    eyebrow="Portfolio builder"
    title="Build your portfolio"
    lead="Add documents, group them into folders, then export them as one PDF."
  />

  <!-- Who you are, and where the files actually live. -->
  <div class="mb-8 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-line bg-surface px-4 py-3 text-sm">
    <span class="inline-flex size-2 rounded-full bg-positive" aria-hidden="true"></span>
    <p>
      Signed in as <strong id="signed-in-as" class="font-medium">…</strong>
    </p>
    <p class="text-xs text-ink-muted">
      Documents are stored in Cloudflare R2 and reachable from any device you sign in on.
    </p>
  </div>

  <!-- Profile: printed on the PDF cover page. -->
  <section class="card mb-6">
    <h2 class="mb-1 text-base font-semibold">Cover details</h2>
    <p class="prose-body mb-4 text-xs">These appear on the front page of the exported PDF.</p>
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5">
        <span class="text-xs font-medium">Your name</span>
        <input id="profile-name" type="text" placeholder="e.g. Jordan Rivers" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm" />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="text-xs font-medium">Title or role</span>
        <input id="profile-title" type="text" placeholder="e.g. Registered Nurse" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm" />
      </label>
      <label class="flex flex-col gap-1.5 sm:col-span-2">
        <span class="text-xs font-medium">Short summary</span>
        <textarea id="profile-summary" rows="2" placeholder="One or two lines about what this portfolio contains." class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"></textarea>
      </label>
    </div>
  </section>

  <!-- De-identification gate. Hidden by the controller once acknowledged;
       server-side, uploads are refused until the record exists. -->
  <section
    id="deid-gate"
    hidden
    class="mb-8 rounded-lg border border-caution/30 bg-caution-surface p-5"
  >
    <h2 class="text-base font-semibold text-caution">Before you upload anything</h2>
    <p class="mt-2 text-sm text-caution">
      Portfolio evidence often includes other people's work, including students'.
      Treat it as the most sensitive material this app holds.
    </p>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-caution">
      <li>Remove names, student numbers, dates of birth and photographs of faces.</li>
      <li>Refer to individuals by a pseudonym or as Focus Student A, B and C.</li>
      <li>Check your school's and university's rules before storing anything about a student.</li>
      <li>Rename files too. A filename can identify someone just as easily.</li>
    </ul>
    <p class="mt-3 text-xs text-caution/90">
      We warn you if a filename looks like it contains an identifier. That check is a
      safety net, not a substitute for checking yourself.
    </p>

    <label class="mt-4 flex items-start gap-2 text-sm text-caution">
      <input id="deid-confirm" type="checkbox" class="mt-0.5" />
      <span>
        I understand, and I will de-identify student material before uploading it.
      </span>
    </label>
    <button
      id="deid-accept"
      type="button"
      class="mt-4 rounded-md bg-caution px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
    >
      Confirm and enable uploads
    </button>
  </section>

  <!-- Toolbar -->
  <div class="mb-6 flex flex-wrap items-center gap-2">
    <button id="add-files" type="button" disabled class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">
      Add files
    </button>
    <button id="new-folder" type="button" class="rounded-lg border border-line bg-surface px-4 py-2 text-sm font-medium transition hover:border-accent/40">
      New folder
    </button>
    <button id="export-pdf" type="button" disabled class="rounded-lg border border-accent bg-accent-soft px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent hover:text-white disabled:cursor-not-allowed disabled:opacity-50">
      Export PDF
    </button>
    <p id="export-status" role="status" aria-live="polite" class="text-xs text-ink-muted"></p>
    <button id="clear-all" type="button" class="ml-auto text-xs text-ink-muted underline underline-offset-2 hover:text-critical">
      Clear everything
    </button>
    <input id="file-input" type="file" multiple class="sr-only" />
  </div>

  <div class="grid gap-6 lg:grid-cols-[16rem_1fr]">
    <!-- Folder tree -->
    <aside class="card h-fit p-3">
      <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wider text-ink-muted">Folders</p>
      <div id="folder-tree"></div>
    </aside>

    <!-- Documents in the selected folder -->
    <section>
      <div class="mb-3 flex items-baseline justify-between gap-3">
        <h2 id="list-heading" class="text-lg font-semibold">All documents</h2>
        <div class="flex items-center gap-2">
          <span
            id="pending-detail"
            hidden
            class="rounded-sm bg-caution-surface px-2.5 py-0.5 text-xs font-medium text-caution"
          ></span>
          <p id="usage" class="text-xs text-ink-muted"></p>
        </div>
      </div>

      <div id="folder-note-wrap" class="mb-4" hidden>
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium">Section note</span>
          <textarea id="folder-note" rows="2" placeholder="Optional. Introduces this section on its divider page in the PDF." class="rounded-lg border border-line bg-surface px-3 py-2 text-xs"></textarea>
        </label>
      </div>

      <div id="document-list" class="grid gap-4 sm:grid-cols-2"></div>
    </section>
  </div>

  <!-- Full-page drop target hint, shown while dragging. -->
  <div
    id="drop-hint"
    hidden
    class="pointer-events-none fixed inset-0 z-40 flex items-center justify-center bg-accent/10 backdrop-blur-[1px]"
  >
    <p class="rounded-lg border-2 border-dashed border-accent bg-surface px-8 py-6 text-sm font-medium text-accent">
      Drop files to add them
    </p>
  </div>
</BaseLayout>

<script>
  import { initVault } from '../lib/vault/ui';
  initVault();
</script>
