---
/**
 * Every artefact, filed.
 *
 * The same folder browser a project's Evidence tab uses, over the whole vault
 * rather than one project's records. The shell is prerendered; the data comes
 * from /api/* at runtime, and PDF assembly happens in the browser.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="All Artefacts" description="Every file you have captured, across every project.">
  <!-- De-identification gate. Hidden by the controller once acknowledged;
       server-side, uploads are refused until the record exists. This one stays
       in full: it is the recorded acknowledgement that the warning was given. -->
  <section
    id="deid-gate"
    hidden
    class="mb-8 rounded-lg border border-caution/30 bg-caution-surface p-5"
  >
    <h2 class="text-base font-semibold text-caution">Before you upload anything</h2>
    <p class="mt-2 text-sm text-caution">
      Portfolio evidence often includes other people's work, including students'.
      Treat it as the most sensitive material this app holds.
    </p>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-caution">
      <li>Remove names, student numbers, dates of birth and photographs of faces.</li>
      <li>Refer to individuals by a pseudonym or as Focus Student A, B and C.</li>
      <li>Check your school's and university's rules before storing anything about a student.</li>
      <li>Rename files too. A filename can identify someone just as easily.</li>
    </ul>
    <p class="mt-3 text-xs text-caution/90">
      We warn you if a filename looks like it contains an identifier. That check is a
      safety net, not a substitute for checking yourself.
    </p>

    <label class="mt-4 flex items-start gap-2 text-sm text-caution">
      <input id="deid-confirm" type="checkbox" class="mt-0.5" />
      <span>
        I understand, and I will de-identify student material before uploading it.
      </span>
    </label>
    <button
      id="deid-accept"
      type="button"
      class="mt-4 rounded-md bg-caution px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
    >
      Confirm and enable uploads
    </button>
  </section>

  {/*
      One band: the heading, what you can do, what you are looking for, and
      what you are looking at. It used to be four stacked rows — title,
      buttons, search, filters — roughly 200px of chrome before the first file
      appeared on a page whose entire job is showing you files.

      `flex-wrap` and the `lg:` breakpoints do the work. Above ~1024px it is a
      single line. Below that it folds into two tiers in a deliberate order
      rather than wherever the browser happens to break: identity and actions
      on top, finding-things underneath. On a phone the search takes the full
      width, because a 140px search box is a search box nobody uses.
  */}
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <h1 class="mr-auto font-display text-2xl font-normal tracking-[-0.02em] sm:text-3xl lg:mr-0">
      All Artefacts
    </h1>

    {/* Search takes whatever is left. It is the widest thing here on purpose:
        every other control is a fixed choice, this one is typed into. */}
    <div class="order-last w-full lg:order-none lg:ml-4 lg:w-auto lg:min-w-56 lg:flex-1">
      <label for="doc-search" class="sr-only">Search artefacts</label>
      <input
        id="doc-search"
        type="search"
        placeholder="Search every folder…"
        autocomplete="off"
        class="w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm"
      />
    </div>

    {/* Filled by the controller: the unfinished toggle and three facets. */}
    <div id="filter-bar" class="order-last w-full overflow-x-auto lg:order-none lg:w-auto lg:overflow-visible"></div>

    <div class="flex shrink-0 items-center gap-2">
      <button id="add-files" type="button" disabled class="pf-press rounded-md bg-accent px-3.5 py-1.5 text-sm font-medium text-white transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">
        Upload
      </button>
      <button id="new-folder" type="button" class="pf-press rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium transition hover:border-accent/40">
        New folder
      </button>
      <button id="export-pdf" type="button" disabled class="pf-press rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium transition hover:border-accent/40 disabled:cursor-not-allowed disabled:opacity-50">
        Export
      </button>
    </div>
    <input id="file-input" type="file" multiple class="sr-only" />
  </div>

  {/* One status line for all of it. Three separate ones — export, search,
      filter — could never be on screen together, and each reserved its own
      strip of empty page waiting for the chance. */}
  <p id="page-status" role="status" aria-live="polite" class="mb-3 min-h-4 text-xs text-ink-muted"></p>

  <section class="card p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <nav id="folder-crumbs" class="-ml-1 flex flex-wrap items-center gap-1 text-sm text-ink-muted" aria-label="Folder"></nav>
      <p id="usage" class="text-xs text-ink-muted"></p>
    </div>

    <div id="folder-note-wrap" class="mt-3" hidden>
      <label class="flex flex-col gap-1.5">
        <span class="text-xs font-medium">Section note</span>
        <textarea id="folder-note" rows="2" placeholder="Optional. Introduces this section on its divider page in the export." class="rounded-lg border border-line bg-surface px-3 py-2 text-xs"></textarea>
      </label>
    </div>

    <div id="document-list" class="mt-2"></div>
  </section>
</BaseLayout>

<script>
  import { initVault } from '../lib/vault/ui';
  initVault();
</script>
