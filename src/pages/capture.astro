---
/**
 * Capture — the phone screen.
 *
 * Built for one hand in a corridor: the two capture buttons sit at the bottom
 * of the viewport where a thumb reaches, tagging uses large chips rather than
 * dropdowns, and nothing is required before the file is safely uploaded.
 *
 * Deliberately not the builder. Anything needing a keyboard — captions,
 * source, standards, folders — stays on the desktop page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capture"
  description="Capture evidence on your phone in seconds, and tag it later."
>
  <div class="mx-auto w-full max-w-lg pb-40">
    <h1 class="text-2xl font-semibold">Capture</h1>
    <p class="prose-body mt-1 text-sm">
      The file is kept the moment you take it. Then add the details and choose a project —
      or discard it.
    </p>

    <p id="capture-status" role="status" aria-live="polite" class="mt-3 text-xs text-ink-muted"></p>

    <!-- Same acknowledgement record as the builder. -->
    <section
      id="capture-gate"
      hidden
      class="mt-4 rounded-lg border border-caution/30 bg-caution-surface p-4 text-sm text-caution"
    >
      <p class="font-semibold">Before you photograph student work</p>
      <p class="mt-1">
        Keep faces, names and student numbers out of the frame. Refer to individuals
        by a pseudonym. Check your school's rules before capturing anything about a student.
      </p>
      <button
        id="capture-accept"
        type="button"
        class="mt-3 w-full rounded-md bg-caution px-4 py-3 text-sm font-medium text-white"
      >I understand — enable capture</button>
    </section>

    <p class="mt-5 rounded-lg bg-canvas px-3 py-2 text-xs text-ink-muted">
      Check the frame before you shoot: no faces, no names, no student numbers.
    </p>

    <!-- One review card at a time, then what has been saved this session. -->
    <div id="capture-body" class="mt-5 flex flex-col gap-4"></div>
  </div>

  <!-- Thumb zone: pinned to the bottom of the viewport, above the safe area. -->
  <div
    id="capture-bar"
    class="no-print fixed inset-x-0 bottom-0 z-20 border-t border-line bg-surface/95 backdrop-blur"
    style="padding-bottom: env(safe-area-inset-bottom, 0px)"
  >
    <div class="mx-auto flex w-full max-w-lg items-stretch gap-2 p-4">
      <button
        id="capture-photo-button"
        type="button"
        disabled
        class="flex flex-[1.4] flex-col items-center justify-center gap-1 rounded-lg bg-accent px-3 py-3 text-base font-semibold text-white transition disabled:cursor-not-allowed disabled:opacity-50"
      >
        <i data-lucide="camera" class="size-6" aria-hidden="true"></i>
        Camera
      </button>
      <button
        id="capture-photos-button"
        type="button"
        disabled
        class="flex flex-1 flex-col items-center justify-center gap-1 rounded-lg border border-line bg-surface px-3 py-3 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50"
      >
        <i data-lucide="image" class="size-5" aria-hidden="true"></i>
        Photos
      </button>
      <button
        id="capture-file-button"
        type="button"
        disabled
        class="flex flex-1 flex-col items-center justify-center gap-1 rounded-lg border border-line bg-surface px-3 py-3 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50"
      >
        <i data-lucide="paperclip" class="size-5" aria-hidden="true"></i>
        Files
      </button>
    </div>
  </div>

  <!-- Three inputs, because the attributes are what steer the phone:
       `capture` opens the rear camera, `accept` alone opens the photo
       library, and neither opens the file browser. -->
  <input id="capture-photo" type="file" accept="image/*" capture="environment" class="sr-only" />
  <input id="capture-photos" type="file" accept="image/*" multiple class="sr-only" />
  <input id="capture-file" type="file" multiple class="sr-only" />
</BaseLayout>

<script>
  import { initCapture } from '../lib/vault/capture-ui';
  initCapture();
</script>
