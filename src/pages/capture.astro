---
/**
 * /capture — kept only as a door.
 *
 * Capture is an overlay now (see components/CaptureOverlay.astro), because a
 * page meant leaving whatever you were doing and then finding your way back to
 * it. This route survives for the home-screen shortcut, old bookmarks and
 * anything that deep-links here: the overlay script sees the path, swaps the
 * history entry for Home and opens itself, so the address is still good and
 * lands you in the right place.
 *
 * The markup below is what someone sees for the instant before that happens,
 * and what they see if the script never runs at all.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Capture" description="Capture evidence on your phone and tag it later.">
  <div class="mx-auto w-full max-w-lg py-16 text-center">
    <h1 class="font-display text-2xl font-normal">Capture</h1>
    <p class="prose-body mt-2 text-sm">Opening the camera and upload sheet…</p>
    <a href="/" class="mt-4 inline-block text-sm font-medium text-accent hover:underline">Go to Home</a>
  </div>
</BaseLayout>
