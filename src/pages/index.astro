---
/**
 * Home — the neutral entry point.
 *
 * Profolio has two areas: the industry-agnostic portfolio builder, and the
 * teaching portfolio, which is now framed as a worked example of what a
 * fully-specified portfolio looks like rather than as the whole product.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { artefacts, phases, portfolio, standards } from '../lib/portfolio';
---

<BaseLayout
  title="Home"
  description="Profolio — a digital evidence vault and showcase for any profession."
>
  <PageHeader
    eyebrow="Professional evidence vault"
    title="Profolio"
    lead="Collect the evidence of your practice in one place, organise it the way you want to present it, and export it as a portfolio you can hand over."
  />

  <div class="mb-14 grid gap-4 md:grid-cols-2">
    <a
      href="/portfolio"
      class="card group flex flex-col gap-3 border-accent/30 bg-accent-soft/40 transition hover:border-accent/60 hover:shadow-[0_2px_12px_rgba(20,24,31,0.08)]"
    >
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Start here</span>
      <h2 class="text-xl font-semibold group-hover:text-accent">
        Build your own portfolio <span aria-hidden="true">→</span>
      </h2>
      <p class="prose-body text-sm">
        Upload documents, group them into folders, and export the whole thing as one organised
        PDF. Nothing about it assumes an industry — nurse, teacher, designer, tradesperson.
      </p>
      <p class="mt-auto text-xs text-ink-muted">
        Runs entirely in your browser. No account needed.
      </p>
    </a>

    <a
      href="/sequence"
      class="card group flex flex-col gap-3 transition hover:border-accent/40 hover:shadow-[0_2px_12px_rgba(20,24,31,0.07)]"
    >
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">
        Worked example
      </span>
      <h2 class="text-xl font-semibold group-hover:text-accent">
        Teaching portfolio <span aria-hidden="true">→</span>
      </h2>
      <p class="prose-body text-sm">
        A five-week teaching sequence with evidence mapped to the {portfolio.frameworkName}.
        Shows what a portfolio looks like once it is tailored to a profession's standards
        framework.
      </p>
      <dl class="mt-auto flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
        <div><dt class="inline">Weeks</dt> <dd class="inline font-medium text-ink">{phases.length}</dd></div>
        <div><dt class="inline">Artefacts</dt> <dd class="inline font-medium text-ink">{artefacts.length}</dd></div>
        <div><dt class="inline">{portfolio.framework} standards</dt> <dd class="inline font-medium text-ink">{standards.length}</dd></div>
      </dl>
    </a>
  </div>

  <section class="mb-14">
    <h2 class="mb-4 text-xl font-semibold">How it works</h2>
    <ol class="grid gap-4 sm:grid-cols-3">
      {
        [
          {
            step: '1',
            title: 'Add your documents',
            body: 'Drag in PDFs, images and files. Everything stays on your device.',
          },
          {
            step: '2',
            title: 'Organise into folders',
            body: 'Folders become the sections of your portfolio, with an optional note on each.',
          },
          {
            step: '3',
            title: 'Export a PDF',
            body: 'One file with a cover, contents page and every document laid out in order.',
          },
        ].map((item) => (
          <li class="card flex flex-col gap-2">
            <span class="flex size-7 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
              {item.step}
            </span>
            <h3 class="text-base font-semibold">{item.title}</h3>
            <p class="prose-body text-sm">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="rounded-xl border border-line bg-surface p-6">
    <h2 class="text-base font-semibold">Where this is going</h2>
    <p class="prose-body mt-2 max-w-2xl text-sm">
      Portfolios currently live in your browser, which keeps the app free and private but means
      they do not follow you between devices. Accounts and cloud storage are the next step;
      profession-specific standards frameworks — beyond the {portfolio.framework} example — come
      after that.
    </p>
  </section>
</BaseLayout>
