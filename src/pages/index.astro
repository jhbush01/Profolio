---
/**
 * The hub — every visitor is signed in (Cloudflare Access gates the whole
 * site), so this is a record rather than a landing page.
 *
 * The shell is prerendered and the content is drawn client-side from
 * /api/vault and /api/programmes, the same way the builder and programmes
 * pages work. What is on it scales with how much record exists: one live
 * programme leads while there is one, and career totals only earn their place
 * once there is a career to total.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="My record"
  description="Your evidence, the programmes you are collecting for, and what still needs doing."
>
  <!-- Filled by initHome(). The skeleton keeps the page from jumping once the
       two API calls land. -->
  <div id="home">
    <div class="flex animate-pulse flex-col gap-8">
      <div class="flex items-start gap-5">
        <div class="size-16 rounded-md bg-canvas"></div>
        <div class="flex flex-col gap-2">
          <div class="h-10 w-64 rounded-md bg-canvas"></div>
          <div class="h-4 w-40 rounded-md bg-canvas"></div>
        </div>
      </div>
      <div class="h-52 rounded-lg bg-canvas"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initHome } from '../lib/vault/home-ui';
  initHome();
</script>
