---
/** Evidence module — placeholder upload UI plus the artefact list. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EvidenceUpload from '../components/EvidenceUpload.astro';
import ArtefactList from '../components/ArtefactList.astro';
import { artefacts } from '../lib/portfolio';
---

<BaseLayout title="Evidence">
  <PageHeader title="Artefacts" />

  <div class="mb-8 rounded-lg border border-line bg-surface p-4 text-sm">
    <p class="font-medium">This page is a worked example, not a live uploader.</p>
    <p class="prose-body mt-1">
      The artefacts below are sample records from <code class="rounded bg-canvas px-1 py-0.5 text-xs">src/data/artefacts.json</code>.
      To upload your own files, use the{' '}
      <a href="/portfolio" class="text-accent underline underline-offset-2">portfolio builder</a> —
      that one stores documents in R2 and exports a PDF.
    </p>
  </div>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Add evidence</h2>
    <EvidenceUpload />
  </section>

  <section>
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Collected artefacts</h2>
      <span class="text-sm text-ink-muted">{artefacts.length} items</span>
    </div>
    <ArtefactList artefacts={artefacts} showFilters />
  </section>
</BaseLayout>
