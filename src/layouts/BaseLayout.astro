---
/**
 * BaseLayout — chrome for every authoring/browsing page.
 * Presentation mode uses PresentationLayout instead (no nav, no footer).
 */
import NavDrawer from '../components/NavDrawer.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/portfolio';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * 'app' — working surfaces (your ProFolio, a project, evidence, export).
   * These are grids and tables, and they should use the screen they are on.
   * 'reading' — pages that are mostly prose, held to a reading measure.
   */
  width?: 'app' | 'reading';
}

const { title, description = site.tagline, width = 'app' } = Astro.props;
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Home-screen install. start_url is /capture, because the reason to keep
         this on a phone is capture, not browsing. A service worker (and with it
         offline capture) is deliberately not here yet — see docs/PRODUCT.md. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Profolio" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#8b5d33" />
    <title>{title} · {site.name}</title>
    <script src="https://unpkg.com/lucide@0.544.0/dist/umd/lucide.js"></script>
  </head>
  <body class="min-h-screen" data-shell={width}>
    <NavDrawer />
    <main class="pf-shell py-10">
      <slot />
    </main>
    <Footer />
    <BottomNav />
    <script>
      // @ts-expect-error — lucide is loaded globally from the CDN script above.
      window.lucide?.createIcons();

      // createIcons leaves the placeholder in place when the CDN is unreachable
      // or a glyph name is unknown, which puts an empty box above every nav
      // label. Drop the empties so those labels close up instead.
      document.querySelectorAll('i[data-lucide]').forEach((icon) => {
        if (!icon.firstElementChild) icon.remove();
      });
    </script>
  </body>
</html>
