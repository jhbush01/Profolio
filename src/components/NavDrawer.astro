---
/**
 * Slide-out navigation drawer.
 *
 * Replaces the old inline top-bar nav. The drawer is always available (it is
 * not a mobile-only pattern here) because the app now has two distinct areas —
 * the generic portfolio builder and the teaching portfolio — and a flat row of
 * links stopped describing that structure.
 *
 * Progressive enhancement: the markup is a plain <nav> with real links. If the
 * script fails, the drawer is still reachable and the links still work.
 */
import AccountMenu from './AccountMenu.astro';
import { portfolio } from '../lib/portfolio';

const path = Astro.url.pathname;

/**
 * Moving around the ProFolio, and nothing else.
 *
 * Working inside one project — its checklist, its evidence, its dates, closing
 * it — belongs to that project's own tab bar. A drawer that also carried
 * project actions meant two places to look for the same thing, and the drawer
 * always lost, because it is the one you have to open first.
 *
 * The teaching-sequence pages underneath are a fixed sample built from
 * src/data/*.json. They used to sit as peers of the real features, which read
 * as though the app shipped with someone else's evidence already in it.
 */
/**
 * Names, not explanations. A drawer where every line carries a subtitle is a
 * drawer you have to read rather than scan, and a teacher does not need to be
 * told what "Projects" is.
 */
interface NavLink {
  href: string;
  label: string;
}

const sections: { label: string | null; links: NavLink[] }[] = [
  {
    label: null,
    links: [
      { href: '/', label: 'Home' },
      { href: '/programmes', label: 'Projects' },
      { href: '/capture', label: 'Capture' },
      { href: '/portfolio', label: 'Artefacts' },
      { href: '/export', label: 'Export' },
      { href: '/pedagogy', label: 'My pedagogy' },
      { href: '/account', label: 'Account' },
      { href: '/privacy', label: 'Privacy' },
    ],
  },
  {
    label: 'Worked example',
    links: [
      { href: '/sequence', label: 'A teaching sequence' },
      { href: '/standards', label: `${portfolio.framework} alignment` },
      { href: '/present', label: 'Presentation mode' },
    ],
  },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

/**
 * The workflow, as a row on wider screens and a bar under a thumb on phones.
 *
 * Artefacts is here on desktop and not on the phone bar: the phone bar has four
 * thumb-sized targets and Capture has to be one of them, while a cursor can
 * reach a fifth without anything getting smaller.
 */
const primary = [
  { href: '/', label: 'Home' },
  { href: '/programmes', label: 'Projects', also: ['/project'] },
  { href: '/capture', label: 'Capture' },
  { href: '/portfolio', label: 'Artefacts' },
  { href: '/export', label: 'Export' },
];

const primaryActive = (link: { href: string; also?: string[] }) =>
  link.href === '/'
    ? path === '/'
    : path.startsWith(link.href) || (link.also ?? []).some((p) => path.startsWith(p));

/**
 * Where you are, as a trail you can click back through.
 *
 * One back arrow can only ever undo one step, and inside a project — three
 * tabs and two folders deep — the step it undoes is rarely the one you want.
 * A trail says where you are and lets you leave from any point in it.
 *
 * Built from the path here, and extended client-side by pages that know more
 * than the URL does (a project's name, the open tab, the open folder). Server
 * side it is honest about what it knows and nothing more.
 */
const TRAIL_NAMES: Record<string, string> = {
  '/': 'Home',
  '/programmes': 'Projects',
  '/project': 'Projects',
  '/portfolio': 'All Artefacts',
  '/capture': 'Capture',
  '/export': 'Export',
  '/pedagogy': 'My pedagogy',
  '/account': 'Account',
  '/privacy': 'Privacy',
  '/data-profile': 'Data collection profile',
  '/standards': `${portfolio.framework} alignment`,
  '/sequence': 'A teaching sequence',
  '/present': 'Presentation mode',
};

const root = `/${path.split('/').filter(Boolean)[0] ?? ''}`;
const here = TRAIL_NAMES[root];

// The trail starts at Home unless you are on it. A project page adds its own
// segments from the client, so this is the part the server can be sure of.
const trail =
  path === '/'
    ? []
    : [
        { href: '/', label: 'Home' },
        ...(here ? [{ href: root === '/project' ? '/programmes' : root, label: here }] : []),
      ];

// The arrow is for the flat pages, where "back" means one thing: Home. Inside a
// project the trail does the job and an arrow beside it is a second, worse
// answer to the same question.
const showBack = path !== '/' && !path.startsWith('/project');
---

<header class="no-print sticky top-0 z-30 border-b border-line-subtle bg-paper/90 backdrop-blur">
  <div class="pf-shell flex items-center gap-2 py-3">
    {/* Always the first thing in the bar, on every page and every width, so
        the way into the rest of the app never moves. Icon-only, with the
        label carried by aria-label and the three bars everyone already
        reads as a menu. */}
    <button
      type="button"
      id="drawer-open"
      aria-controls="app-drawer"
      aria-expanded="false"
      aria-label="Open menu"
      class="flex size-9 shrink-0 items-center justify-center rounded-md border border-line transition hover:border-accent/40 hover:text-accent"
    >
      <i data-lucide="menu" class="size-5" aria-hidden="true"></i>
      {/* Drawn in CSS as well as fetched, because the icon comes from a CDN
          and a button with nothing in it is an invisible control. */}
      <span class="pf-burger" aria-hidden="true"></span>
    </button>

    {
      showBack && (
        <a
          href="/"
          aria-label="Back to Home"
          class="flex min-h-9 items-center gap-1.5 rounded-md px-2 text-sm font-medium text-ink-muted transition hover:bg-canvas hover:text-accent"
        >
          <i data-lucide="arrow-left" class="size-5" aria-hidden="true" />
          {/* "Back", not "Home", at every width: the nav row beside this one
              carries Home, and a bar that says the same word twice a
              centimetre apart is a bar nobody reads. Always a word, because
              the icon comes from a CDN. */}
          <span>Back</span>
        </a>
      )
    }

    {/* Desktop only: the phone bar's workflow, in the top bar. */}
    <nav class="ml-2 hidden items-center gap-1 sm:flex" aria-label="Primary, desktop">
      {primary.map((link) => (
        <a
          href={link.href}
          aria-current={primaryActive(link) ? 'page' : undefined}
          class:list={[
            'rounded-md px-2.5 py-1.5 text-sm font-medium transition',
            primaryActive(link)
              ? 'bg-accent-soft text-accent'
              : 'text-ink-muted hover:bg-canvas hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* The wordmark sits with the account button, at the right end. It used to
        follow the back arrow, which meant it moved every time the arrow came
        and went — a fixed point that is not fixed is worse than no fixed
        point. It is identity here, not navigation: the nav row and the Home
        link already go home, and a third link to the same place is noise. */}
    <div class="ml-auto flex items-center gap-3">
      {/* Shown at every width now. On a phone the bar was a hamburger, a back
          arrow and a large gap, which reads as a page that failed to load. */}
      <span class="font-display text-base font-normal">Profolio</span>
      <AccountMenu />
    </div>
  </div>

  {
    trail.length > 0 && (
      <div class="border-t border-line-subtle/60">
        <nav class="pf-shell flex items-center gap-1 overflow-x-auto py-1.5 text-[0.7rem] text-ink-faint" aria-label="Breadcrumb">
          {trail.map((crumb, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={crumb.href} class="shrink-0 rounded px-1 transition hover:text-accent">
                {crumb.label}
              </a>
            </>
          ))}
          {/* Pages that know more than the path extend this. */}
          <span id="trail-extra" class="flex items-center gap-1"></span>
        </nav>
      </div>
    )
  }
</header>

<!-- Overlay + drawer. `hidden` is toggled by the script; CSS handles the slide. -->
<div id="drawer-overlay" class="no-print fixed inset-0 z-40 bg-ink/40 opacity-0 transition-opacity duration-200" hidden></div>

<aside
  id="app-drawer"
  class="no-print fixed inset-y-0 left-0 z-50 flex w-[19rem] max-w-[85vw] -translate-x-full flex-col border-r border-line bg-surface transition-transform duration-200 ease-out"
  aria-label="Main navigation"
  aria-hidden="true"
>
  <div class="flex items-center justify-between border-b border-line px-5 py-4">
    <p class="font-display text-lg font-normal">Profolio</p>
    <button
      type="button"
      id="drawer-close"
      aria-label="Close menu"
      class="rounded-md p-1.5 text-ink-muted transition hover:bg-canvas hover:text-ink"
    >
      <i data-lucide="x" class="size-5" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4">
    {
      sections.map((section) => (
        <div class="mb-5 last:mb-0">
          {section.label && <p class="pf-eyebrow mb-1.5 px-2 text-ink-faint">{section.label}</p>}
          <ul class="space-y-0.5">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2 transition',
                    isActive(link.href)
                      ? 'bg-accent-soft text-accent'
                      : 'hover:bg-canvas',
                  ]}
                >
                  <span class="block text-sm font-medium">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  {/* Kept: where the files physically are is a fair thing for someone
      uploading children's work to be able to find without hunting. */}
  <p class="border-t border-line px-5 py-3 text-[0.7rem] leading-relaxed text-ink-muted">
    Files are stored in Cloudflare R2. <a href="/privacy" class="underline hover:text-accent">Privacy</a>
  </p>
</aside>

<script>
  const drawer = document.getElementById('app-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const openButton = document.getElementById('drawer-open');
  const closeButton = document.getElementById('drawer-close');

  if (drawer && overlay && openButton && closeButton) {
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      overlay.hidden = false;
      // Next frame, so the opacity transition has a starting value to animate from.
      requestAnimationFrame(() => overlay.classList.replace('opacity-0', 'opacity-100'));
      drawer.classList.remove('-translate-x-full');
      drawer.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeButton.focus();
    };

    const close = () => {
      overlay.classList.replace('opacity-100', 'opacity-0');
      drawer.classList.add('-translate-x-full');
      drawer.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        overlay.hidden = true;
      }, 200);
      lastFocused?.focus();
    };

    openButton.addEventListener('click', open);
    closeButton.addEventListener('click', close);
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') close();
    });

    // Keep tabbing inside the drawer while it is open.
    drawer.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = drawer.querySelectorAll<HTMLElement>('a[href], button');
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
