---
/** Consistent page title block. */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="mb-8">
  {
    eyebrow && (
      <p class="mb-1 text-xs font-medium uppercase tracking-[0.14em] text-accent">{eyebrow}</p>
    )
  }
  <h1 class="text-3xl font-semibold sm:text-4xl">{title}</h1>
  {lead && <p class="prose-body mt-3 max-w-2xl text-base">{lead}</p>}
  <slot />
</div>
