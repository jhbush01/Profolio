---
/** Consistent page title block. */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="mb-8">
  {eyebrow && <p class="pf-eyebrow mb-2 text-accent">{eyebrow}</p>}
  <h1 class="font-display text-4xl font-normal tracking-[-0.02em] sm:text-5xl">{title}</h1>
  {lead && <p class="prose-body mt-3 max-w-2xl text-base">{lead}</p>}
  <slot />
</div>
