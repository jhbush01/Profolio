---
/**
 * EvidenceUpload — PLACEHOLDER upload UI for the teaching example. Nothing is
 * stored; the form deliberately has no `action`.
 *
 * Real uploads live at /portfolio, which is backed by R2 + D1 (see
 * src/lib/server/repo.ts). This module is NOT wired to that backend because
 * teaching artefacts carry two extra dimensions the generic builder has no
 * concept of: the week of the sequence, and APST standard tags.
 *
 * FUTURE: to make this real, add `week` and `standards` columns to the
 * documents table, extend POST /api/documents to accept them, and swap this
 * form for the same API client the builder uses. The UI below already collects
 * both fields.
 */
import StandardTagPicker from './StandardTagPicker.astro';
import { phases } from '../lib/portfolio';
---

<form class="flex flex-col gap-5" aria-describedby="upload-note">
  <p id="upload-note" class="prose-body text-sm">
    Placeholder form — files are not uploaded and nothing is saved. This exists
    to fix the shape of the upload flow before the storage layer is built.
  </p>

  <!-- Drop zone. FUTURE: dragover/drop handlers + file list preview. -->
  <label
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-line bg-surface px-6 py-12 text-center transition hover:border-accent/50 hover:bg-accent-soft/30"
  >
    <span class="text-sm font-medium">Drop files here, or browse</span>
    <span class="text-xs text-ink-muted">
      Lesson plans, work samples, data, photos · PDF, DOCX, XLSX, PNG, JPG
    </span>
    <input type="file" name="files" multiple class="sr-only" />
  </label>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium">Title</span>
      <input
        type="text"
        name="title"
        placeholder="e.g. Week 3 — differentiated task sheet"
        class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
      />
    </label>

    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium">Week</span>
      <select name="week" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
        <option value="">Unassigned</option>
        {phases.map((phase) => <option value={phase.slug}>Week {phase.number} — {phase.title}</option>)}
      </select>
    </label>

    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium">Evidence type</span>
      <select name="type" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
        <option value="lesson-plan">Lesson plan</option>
        <option value="planning">Planning</option>
        <option value="student-work">Student work</option>
        <option value="data">Data</option>
        <option value="reflection">Reflection</option>
        <option value="media">Media</option>
        <option value="other">Other</option>
      </select>
    </label>

    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium">Caption</span>
      <input
        type="text"
        name="caption"
        placeholder="What does this artefact demonstrate?"
        class="rounded-lg border border-line bg-surface px-3 py-2 text-sm"
      />
    </label>
  </div>

  <StandardTagPicker legend="Tag this artefact" />

  <div class="flex items-center gap-3">
    <button
      type="button"
      disabled
      class="cursor-not-allowed rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white opacity-50"
    >
      Upload evidence
    </button>
    <span class="text-xs text-ink-muted">
      Not wired up — this is the teaching example. Use the{' '}
      <a href="/portfolio" class="text-accent underline underline-offset-2">portfolio builder</a>{' '}
      to actually upload files.
    </span>
  </div>
</form>
