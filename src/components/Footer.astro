---
/** Site footer. Kept deliberately thin. */
import { portfolio } from '../lib/portfolio';

const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line bg-surface">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-5 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{portfolio.title} · {portfolio.owner} · {year}</p>
    <p>
      Evidence mapped to the {portfolio.frameworkName} ({portfolio.framework}).
      De-identify student work before uploading.
    </p>
  </div>
</footer>
