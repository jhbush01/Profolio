---
/**
 * Site footer. App-level, so it must not carry teaching-specific wording —
 * that belongs on the teaching-portfolio pages themselves.
 */
import { site } from '../lib/portfolio';

const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line-subtle">
  <div
    class="pf-shell flex flex-col gap-1 pb-28 pt-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:pb-6"
  >
    <p class="font-display">{site.name} · {year}</p>
    <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <a href="/privacy" class="transition hover:text-accent">Privacy</a>
      <a href="/account" class="transition hover:text-accent">Your data</a>
      <span class="text-ink-faint">{site.note}</span>
    </p>
  </div>
</footer>
