---
/**
 * Site footer. App-level, so it must not carry teaching-specific wording —
 * that belongs on the teaching-portfolio pages themselves.
 */
import { site } from '../lib/portfolio';

const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line bg-surface">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-5 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{site.name} · {year}</p>
    <p>{site.note}</p>
  </div>
</footer>
