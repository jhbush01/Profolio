---
/**
 * ArtefactCard — one stored piece of evidence.
 *
 * FUTURE: `fileName` becomes a link to a signed R2 URL, and image/PDF types
 * get an inline thumbnail preview.
 */
import StandardTag from './StandardTag.astro';
import { artefactTypeLabel, getPhase } from '../lib/portfolio';
import type { Artefact } from '../types';

interface Props {
  artefact: Artefact;
  /** Hide the week line when the card is already inside a week page. */
  showPhase?: boolean;
}

const { artefact, showPhase = true } = Astro.props;
const phase = artefact.week ? getPhase(artefact.week) : undefined;

// Built as a string rather than inline template expressions: Astro collapses
// the whitespace at a line break before an expression, which silently eats the
// spaces around the separators.
const meta = [
  artefactTypeLabel(artefact.type),
  showPhase && phase ? `Week ${phase.number}` : null,
  `Added ${artefact.addedOn}`,
]
  .filter(Boolean)
  .join(' \u00b7 ');
---

<article class="card flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold leading-snug">{artefact.title}</h3>
      <p class="mt-1 text-xs text-ink-muted">{meta}</p>
    </div>
    <span
      class="shrink-0 rounded-md bg-canvas px-2 py-1 text-[0.7rem] font-medium text-ink-muted"
      >{artefact.sizeLabel}</span
    >
  </div>

  <p class="prose-body text-sm">{artefact.caption}</p>

  <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-line pt-3">
    <code class="rounded bg-canvas px-2 py-0.5 text-[0.7rem] text-ink-muted">{artefact.fileName}</code>
    <div class="ml-auto flex flex-wrap gap-1.5">
      {artefact.standards.map((code) => <StandardTag code={code} />)}
    </div>
  </div>
</article>
