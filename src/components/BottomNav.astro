---
/**
 * Phone navigation. Four destinations, with capture deliberately heaviest —
 * it is the reason the app is on a phone at all (see docs/PRODUCT.md).
 *
 * Only the things done regularly. Everything else — all artefacts, the data
 * collection profile, privacy, the worked example — lives in the drawer,
 * which is the full map on a phone and the main navigation on desktop.
 *
 * Evidence is not here on purpose: captured evidence is assigned to a project,
 * so a project is where you go looking for it. All artefacts is the search
 * across projects, which is a less frequent errand than the four below.
 *
 * Hidden on /capture, which runs its own action bar along the bottom. Two
 * stacked bars would put the camera under the nav instead of under a thumb.
 */
const path = Astro.url.pathname;
const hidden = path.startsWith('/capture') || path.startsWith('/present');

interface NavLink {
  href: string;
  label: string;
  icon: string;
  /** Extra path prefixes that should light this up. */
  also?: string[];
}

// Deliberately the same labels as the drawer uses on wider screens: two names
// for one destination is how navigation stops being trusted.
const links: NavLink[] = [
  { href: '/', label: 'ProFolio', icon: 'house' },
  // Being inside one project is still "Projects" as far as where-am-I goes.
  { href: '/programmes', label: 'Projects', icon: 'folder', also: ['/project'] },
  { href: '/export', label: 'Export', icon: 'download' },
];

const isActive = (link: NavLink) =>
  link.href === '/'
    ? path === '/'
    : path.startsWith(link.href) || (link.also ?? []).some((prefix) => path.startsWith(prefix));
---

{
  !hidden && (
    <nav
      class="no-print fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface sm:hidden"
      style="padding-bottom: env(safe-area-inset-bottom, 0px)"
      aria-label="Primary"
    >
      <div class="flex items-stretch gap-0.5 px-2 pb-1.5 pt-2">
        {links.slice(0, 2).map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link) ? 'page' : undefined}
            class:list={[
              'flex min-h-14 flex-1 flex-col items-center justify-center gap-1 rounded-md text-[0.7rem] transition',
              isActive(link) ? 'font-medium text-accent' : 'text-ink-muted',
            ]}
          >
            <i data-lucide={link.icon} class="size-5" aria-hidden="true" />
            {link.label}
          </a>
        ))}

        {/* Capture is a destination, not a floating button: the design system
            rules out a FAB, so the emphasis is weight and fill, not lift. */}
        <a
          href="/capture"
          class="flex min-h-14 flex-[1.35] flex-col items-center justify-center gap-1 rounded-lg bg-accent text-[0.75rem] font-semibold text-white shadow-[0_1px_3px_rgba(77,51,22,0.07)] transition"
        >
          <i data-lucide="camera" class="size-[1.4rem]" aria-hidden="true" />
          Capture
        </a>

        {links.slice(2).map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link) ? 'page' : undefined}
            class:list={[
              'flex min-h-14 flex-1 flex-col items-center justify-center gap-1 rounded-md text-[0.7rem] transition',
              isActive(link) ? 'font-medium text-accent' : 'text-ink-muted',
            ]}
          >
            <i data-lucide={link.icon} class="size-5" aria-hidden="true" />
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  )
}
